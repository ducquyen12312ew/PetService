<!-- Delete Pet Modal -->
<div class="modal fade" id="deletePetModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Xác nhận xóa thú cưng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa thú cưng <strong id="deletePetName"></strong>?</p>
                <p class="text-danger">Lưu ý: Hành động này sẽ xóa toàn bộ thông tin y tế và lịch sử của thú cưng!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <form id="deletePetForm" action="/admin/users/pets/delete" method="POST">
                    <input type="hidden" id="deletePetId" name="petId">
                    <button type="submit" class="btn btn-danger">Xóa thú cưng</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // JavaScript cho User Management
    // Show edit user modal
    document.querySelectorAll('.edit-user-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            const name = this.getAttribute('data-name');
            const email = this.getAttribute('data-email');
            const phone = this.getAttribute('data-phone');
            const role = this.getAttribute('data-role');
            
            document.getElementById('editUserId').value = id;
            document.getElementById('editUsername').value = name;
            document.getElementById('editEmail').value = email;
            document.getElementById('editPhone').value = phone;
            document.getElementById('editRole').value = role;
            
            const editModal = new bootstrap.Modal(document.getElementById('editUserModal'));
            editModal.show();
        });
    });
    
    // Show delete user modal
    document.querySelectorAll('.delete-user-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            const name = this.getAttribute('data-name');
            
            document.getElementById('deleteUserId').value = id;
            document.getElementById('deleteUserName').textContent = name;
            
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteUserModal'));
            deleteModal.show();
        });
    });
    
    // Toggle password reset fields
    document.getElementById('resetPassword').addEventListener('change', function() {
        const newPasswordGroup = document.getElementById('newPasswordGroup');
        if (this.checked) {
            newPasswordGroup.style.display = 'block';
        } else {
            newPasswordGroup.style.display = 'none';
        }
    });
    
    // Filter users functionality
    document.getElementById('filterBtn').addEventListener('click', function() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const roleFilter = document.getElementById('roleFilter').value;
        const rows = document.querySelectorAll('tbody tr');
        
        rows.forEach(row => {
            if (row.cells.length < 7) return; // Skip if not a user row
            
            const name = row.cells[1].textContent.toLowerCase();
            const email = row.cells[2].textContent.toLowerCase();
            const phone = row.cells[3].textContent.toLowerCase();
            
            // Xác định role thực tế dựa vào class của badge
            let roleValue = '';
            const badge = row.querySelector('.badge');
            if (badge) {
                if (badge.classList.contains('role-admin')) roleValue = 'admin';
                else if (badge.classList.contains('role-vet')) roleValue = 'vet';
                else if (badge.classList.contains('role-staff')) roleValue = 'staff';
            }
            
            const matchesSearch = name.includes(searchTerm) || email.includes(searchTerm) || phone.includes(searchTerm);
            const matchesRole = roleFilter === '' || roleValue === roleFilter;
            
            if (matchesSearch && matchesRole) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    // JavaScript cho Pet Management
    // Add Pet Form Handler
    document.getElementById('addPetForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const petData = Object.fromEntries(formData.entries());
        
        try {
            const response = await fetch('/admin/users/pets/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(petData)
            });
            
            const result = await response.json();
            
            if (result.success) {
                alert('Thêm thú cưng thành công!');
                window.location.reload();
            } else {
                alert('Lỗi: ' + result.message);
            }
        } catch (error) {
            console.error('Error adding pet:', error);
            alert('Có lỗi xảy ra khi thêm thú cưng');
        }
    });

    // Edit Pet Modal
    document.querySelectorAll('.edit-pet-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('editPetId').value = this.getAttribute('data-id');
            document.getElementById('editPetName').value = this.getAttribute('data-name');
            document.getElementById('editPetType').value = this.getAttribute('data-type');
            document.getElementById('editPetBreed').value = this.getAttribute('data-breed');
            document.getElementById('editPetAge').value = this.getAttribute('data-age');
            document.getElementById('editPetWeight').value = this.getAttribute('data-weight');
            document.getElementById('editPetGender').value = this.getAttribute('data-gender');
            document.getElementById('editOwnerName').value = this.getAttribute('data-owner-name');
            document.getElementById('editOwnerPhone').value = this.getAttribute('data-owner-phone');
            document.getElementById('editOwnerEmail').value = this.getAttribute('data-owner-email');
            
            const editModal = new bootstrap.Modal(document.getElementById('editPetModal'));
            editModal.show();
        });
    });

    // Delete Pet Modal
    document.querySelectorAll('.delete-pet-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            const name = this.getAttribute('data-name');
            
            document.getElementById('deletePetId').value = id;
            document.getElementById('deletePetName').textContent = name;
            
            const deleteModal = new bootstrap.Modal(document.getElementById('deletePetModal'));
            deleteModal.show();
        });
    });

    // Filter Pets
    document.getElementById('filterPetsBtn').addEventListener('click', function() {
        const searchTerm = document.getElementById('searchPets').value.toLowerCase();
        const typeFilter = document.getElementById('typeFilter').value;
        const petRows = document.querySelectorAll('.pet-row');
        
        petRows.forEach(row => {
            const name = row.getAttribute('data-name');
            const type = row.getAttribute('data-type');
            const owner = row.getAttribute('data-owner');
            
            const matchesSearch = name.includes(searchTerm) || owner.includes(searchTerm);
            const matchesType = typeFilter === '' || type === typeFilter;
            
            row.style.display = (matchesSearch && matchesType) ? '' : 'none';
        });
    });
</script>
</body>
</html>