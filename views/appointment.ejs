<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đặt lịch dịch vụ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #ffffff;
            color: #333;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .navbar {
            background-color: white;
            color: #333;
        }
        .admin-btn {
            position: fixed;
            bottom: 10px;
            right: 10px;
            width: 10px;
            height: 10px;
            background-color: transparent;
            border: none;
            cursor: default;
            z-index: 999;
        }
        .appointment-form {
            max-width: 700px;
            margin: 50px auto;
            padding: 30px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            border: 1px solid #ddd;
        }
        .appointment-header {
            text-align: center;
            margin-bottom: 30px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .menu-link {
            position: relative;
            display: inline-block;
            font-weight: 500;
            font-size: 1rem;
            transition: color 0.3s ease, transform 0.3s ease;
        }
        
        .menu-link::after {
            content: "";
            position: absolute;
            left: 50%;
            bottom: -5px;
            transform: translateX(-50%);
            width: 0;
            height: 2px;
            background-color: #f7c800;
            transition: none;
        }
        
        .menu-link:hover {
            color: #f7c800;
            transform: scale(1.1);
        }
        
        .menu-link:hover::after {
            animation: wave-effect 0.5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
        }
        
        @keyframes wave-effect {
            0% {
                width: 0;
                left: 50%;
                transform: translateX(-50%);
            }
            50% {
                width: 100%;
                left: 0;
                transform: translateX(0);
            }
            100% {
                width: 0;
                left: 50%;
                transform: translateX(-50%);
            }
        }
        
        .form-floating label {
            color: #666;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #f7c800;
            box-shadow: 0 0 0 0.25rem rgba(247, 200, 0, 0.25);
        }
        
        .btn-primary {
            background-color: #f7c800;
            border-color: #f7c800;
            color: white;
        }
        
        .btn-primary:hover {
            background-color: #e6b800;
            border-color: #e6b800;
        }
        
        .section-title {
            color: #333;
            position: relative;
            display: inline-block;
            margin-bottom: 20px;
        }
        
        .section-title:after {
            content: '';
            position: absolute;
            width: 30px;
            height: 2px;
            background-color: #f7c800;
            bottom: -8px;
            left: 0;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container">
            <a class="navbar-brand text-dark me-3" href="/">
                <i class="fas fa-paw me-2"></i>Pet Care Center
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link text-dark menu-link" href="/">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark menu-link" href="/services">Dịch vụ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark menu-link" href="/appointment">Đặt lịch</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark menu-link" href="/pet-health">Sức khỏe thú cưng</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="appointment-form">
            <div class="appointment-header">
                <i class="fas fa-calendar-check fa-3x text-warning mb-3"></i>
                <h2>Đặt lịch dịch vụ</h2>
                <p class="text-muted">Vui lòng điền thông tin để đặt lịch dịch vụ cho thú cưng của bạn</p>
            </div>

            <% if (typeof error !== 'undefined') { %>
                <div class="alert alert-danger" role="alert">
                    <%= error %>
                </div>
            <% } %>

            <form action="/appointment" method="POST">
                <!-- Thông tin chủ -->
                <h5 class="section-title"><i class="fas fa-user me-2"></i>Thông tin của bạn</h5>
                <div class="row mb-4">
                    <div class="col-md-12 mb-3">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="ownerName" name="ownerName" placeholder="Họ và tên" required>
                            <label for="ownerName">Họ và tên</label>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <input type="tel" class="form-control" id="ownerPhone" name="ownerPhone" placeholder="Số điện thoại" required>
                            <label for="ownerPhone">Số điện thoại</label>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <input type="email" class="form-control" id="ownerEmail" name="ownerEmail" placeholder="Email" required>
                            <label for="ownerEmail">Email</label>
                        </div>
                    </div>
                </div>

                <!-- Thông tin thú cưng -->
                <h5 class="section-title"><i class="fas fa-paw me-2"></i>Thông tin thú cưng</h5>
                <div class="row mb-4">
                    <div class="col-md-12 mb-3">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="petName" name="petName" placeholder="Tên thú cưng" required>
                            <label for="petName">Tên thú cưng</label>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <select class="form-select" id="petType" name="petType" required>
                                <option value="" selected disabled>Chọn loại</option>
                                <option value="dog">Chó</option>
                                <option value="cat">Mèo</option>
                                <option value="bird">Chim</option>
                                <option value="rabbit">Thỏ</option>
                                <option value="other">Khác</option>
                            </select>
                            <label for="petType">Loại thú cưng</label>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="petBreed" name="petBreed" placeholder="Giống">
                            <label for="petBreed">Giống</label>
                        </div>
                    </div>
                </div>
                
                <!-- Loại dịch vụ -->
                <h5 class="section-title"><i class="fas fa-concierge-bell me-2"></i>Dịch vụ</h5>
                <div class="row mb-4">
                    <div class="col-md-12 mb-3">
                        <div class="form-floating">
                            <select class="form-select" id="service" name="service" required>
                                <option value="" selected disabled>Chọn dịch vụ</option>
                                <option value="khám sức khỏe">Khám sức khỏe</option>
                                <option value="tắm">Tắm</option>
                                <option value="cắt tỉa lông">Cắt tỉa lông</option>
                                <option value="lưu trú">Lưu trú</option>
                            </select>
                            <label for="service">Loại dịch vụ</label>
                        </div>
                    </div>
                </div>
                
                <!-- Thời gian -->
                <h5 class="section-title"><i class="fas fa-clock me-2"></i>Thời gian</h5>
                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <input type="date" class="form-control" id="date" name="date" required>
                            <label for="date">Ngày</label>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <select class="form-select" id="time" name="time" required>
                                <option value="" selected disabled>Chọn giờ</option>
                                <option value="09:00">09:00</option>
                                <option value="10:00">10:00</option>
                                <option value="11:00">11:00</option>
                                <option value="14:00">14:00</option>
                                <option value="15:00">15:00</option>
                                <option value="16:00">16:00</option>
                                <option value="17:00">17:00</option>
                            </select>
                            <label for="time">Giờ</label>
                        </div>
                    </div>
                </div>
                
                <!-- Ghi chú -->
                <div class="form-floating mb-4">
                    <textarea class="form-control" id="notes" name="notes" style="height: 100px" placeholder="Nhập ghi chú..."></textarea>
                    <label for="notes"><i class="fas fa-comment-alt me-2"></i>Ghi chú (không bắt buộc)</label>
                </div>
                
                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">Đặt lịch ngay</button>
                </div>
            </form>
            
            <div class="mt-4 text-center">
                <a href="/" class="text-decoration-none">Quay lại trang chủ</a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5>Pet Care Center</h5>
                    <p>Chăm sóc tốt nhất cho người bạn thân yêu của bạn</p>
                </div>
                <div class="col-md-4">
                    <h5>Liên hệ</h5>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-phone me-2"></i> 0982-495-562</li>
                        <li><i class="fas fa-envelope me-2"></i> phanquyenkols.booking@gmail.com</li>
                    </ul>
                </div>
            </div>
            <hr>
            <div class="text-center">
                <p>&copy; 2025 Pet Care Center. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Hidden Admin Button -->
    <button onclick="window.location.href='/admin-secret'" class="admin-btn"></button>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>